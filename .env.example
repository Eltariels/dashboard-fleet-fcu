# MongoDB Atlas connection string (cluster M0 gratuit)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dashboard_fleet

# Secret utilisé pour signer les JWT de session (chaine aleatoire longue, a generer toi-meme)
JWT_SECRET=change-me-avec-une-longue-chaine-aleatoire

# Utilises uniquement par scripts/seedSuperAdmin.js (jamais lus par l'app en prod)
SUPERADMIN_PSEUDO=Pseudo
SUPERADMIN_PASSWORD=MotDePasse
